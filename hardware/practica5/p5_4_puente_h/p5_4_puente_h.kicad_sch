	(text "Diseno (Vm = 9 V, Imotor = 0.5 A, beta BD13x = 25, sobreexcitacion x2):\nIB1 = IB4 = 2 * 0.5 / 25 = 40 mA ;  IC5 = IB1 + 0.7 mA = 41 mA\nIB5 = IC5 / 10 = 4 mA (2N3904 saturado) ;  VB5 = VBE5 + VBE4 = 1.6 V\nR1 = (5 - 1.6) / 4 mA = 850 -> 820 ohm\nR3 = (9 - VEB1 - VCE5sat - VBE4) / IC5 = (9 - 0.9 - 0.2 - 0.85) / 41 mA = 172 -> 180 ohm (0.3 W)\nIN_A = 1, IN_B = 0: Q1+Q4 -> giro A.  IN_A = 0, IN_B = 1: Q2+Q3 -> giro B.\nIN_A = IN_B = 1: PROHIBIDO (Q1-Q3 y Q2-Q4 en corto a traves de la fuente)."
		(exclude_from_sim no)
		(at 289.56 137.16 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "53ca54ea-5b1a-51c8-8812-d897bb534e68")
	)
